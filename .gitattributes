# Применить LF ко всем текстовым файлам
* text=auto eol=lf

# Явно указать LF для скриптов и конфигураций
*.sh text eol=lf
*.bat text eol=lf
*.cmd text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf

# Явно указать для mvnw и mvnw.cmd
/mvnw text eol=lf
/mvnw.cmd text eol=lf


